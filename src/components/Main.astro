---
import { sanityClient } from "../lib/sanity";
import { urlFor } from "../lib/sanityImage";
import DrawerContent from "./DrawerContent.astro";
import PodcastCard from "./PodcastCard.astro";
import HoverTextSection from "./HoverTextSection.astro"
import NewsletterSignup from "./NewsletterSignup.astro";
import ImageInText from "./ImageInText.astro";

const mainContent = await sanityClient.fetch(`
*[_type == "mainContent"][0] {
    heroText,
    orgDesc,
    learnMoreLink,
    servicesImages[] {
    image,
    text
    },
    founderStatement,
    podcastDesc1,
    podcastDesc2,
    spotifyLink,
    appleLink,
    visibilityAdvDesc,
    visibilityAdvImages[] {
    image,
    text
    },
    purchaseLink,
    contactText,
    contactLink,
    addressText
    }
`);
---

<div id="container" class="min-h-dvh">
    <main class="flex flex-col items-center gap-28 md:gap-52 text-cream">
        <!-- Hero section -->
        <section class="relative flex justify-center items-center min-h-dvh z-20">
            <!-- Logo -->
            <img
                    src="/images/bsc logomark_white.svg"
                    alt="brandstyle_logo"
                    class="fixed top-0 left-1/2 w-20 -translate-x-1/2 xl:left-0 xl:top-1/2 xl:-translate-y-1/2 xl:translate-x-0 z-20"
            />
            <button data-drawer="contact" class="nav-text hidden xl:block fixed right-0 top-1/2 -translate-y-1/2 body-text pr-4">Contact</button>
            <h1 class="pointer-events-none title-text pb-32 xl:pb-0 w-[90dvw] md:w-[70dvw] lg:w-[60dvw] xl:w-[50dvw] 2xl:w-[45dvw]">
                {mainContent.heroText}
            </h1>
            <div class="body-text absolute bottom-10 xl:-bottom-8 left-0 w-full text-center flex flex-col justify-center items-center">
                <p class="w-[90dvw] md:w-[50dvw] lg:w-[45dvw] xl:w-[40dvw] 2xl:w-[30dvw]">{mainContent.orgDesc}</p>
                <a href={mainContent.learnMoreLink} class="link-text mt-7 md:mt-10 xl:mt-14">Learn More</a>
            </div>
        </section>
        <section class="relative px-[10dvw] md:px-[8dvw] xl:px-0 flex flex-col gap-8 md:gap-12 xl:gap-18 ">
            <h2 class="body-text text-center">We Do This Through</h2>
            <div class="flex flex-col justify-center items-center md:flex-row md:flex-wrap xl:flex-col gap-9 md:gap-7 xl:gap-12">
                {mainContent.servicesImages?.map((service) => (
                    // MOBILE/TABLET
                    <div class="block xl:hidden relative w-full md:w-fit">
                        <img src={urlFor(service.image).width(1200).url()} alt={service.text} class="w-full md:w-[40dvw] object-cover h-48 md:h-42 lg:h-56"/>
                        <div class="absolute inset-0 px-4 md:px-12 flex items-center justify-center">
                            <p class="title-text md! md:tracking-normal!">{service.text}</p>
                        </div>
                    </div>
                    // DESKTOP
                    <HoverTextSection service={service} />
                ))}
            </div>
            <a href={mainContent.learnMoreLink} class="link-text text-center">Learn More</a>
        </section>
        <section class="relative flex flex-col justify-center items-center gap-8 md:gap-12 xl:gap-18 w-full">
            <ImageInText
                    segments={mainContent.founderStatement}
                    className="w-[90dvw] md:w-[80dvw]"
            />
            <a href={mainContent.learnMoreLink} class="link-text text-center">Learn More</a>
        </section>
        <!-- PODCAST INFO -->
        <section class="relative flex flex-col items-center xl:flex-row w-[90dvw] md:w-[60dvw] xl:w-[70dvw] 2xl:w-[60dvw] gap-8 md:gap-12 xl:gap-18">
            <PodcastCard />
            <div class="w-full 2xl:w-[40dvw] flex flex-col gap-8 xl:gap-12 2xl:gap-24">
                <div class="flex flex-col gap-6">
                    <p class="body-text text-center md:text-start">{mainContent.podcastDesc1}</p>
                    <p class="body-text text-center md:text-start">{mainContent.podcastDesc2}</p>
                </div>
                <div class="text-center md:text-start">
                    <a href={mainContent.spotifyLink} class="link-text">Listen on Spotify</a>
                    <a href={mainContent.appleLink} class="link-text mt-5">Listen on Apple Music</a>
                </div>
            </div>
        </section>
        <!-- VISIBILITY ADVANTAGE -->
        <section class="relative px-[6dvw] md:px-0 flex flex-col justify-center items-center gap-8 md:gap-12 xl:gap-18">
            <h2 class="title-text flex items-center justify-center md:w-[75dvw]">
                {mainContent.visibilityAdvDesc}
            </h2>
            <div class="flex flex-col xl:flex-row gap-8 2xl:gap-12 w-full md:w-fit">
                {mainContent.visibilityAdvImages?.map((adv) => (
                        <div class="relative w-full md:w-[55dvw] xl:w-[25dvw]">
                            <img
                                    src={urlFor(adv.image).width(1200).url()}
                                    alt={adv.text}
                                    class="w-full object-cover h-[25dvh]"
                            />

                            <p class="body-text mt-4">
                                {adv.text}
                            </p>
                        </div>
                ))}
            </div>
            <div class="flex justify-center gap-10 xl:gap-12">
                <a href={mainContent.learnMoreLink} class="link-text w-fit!">Learn More</a>
                <a href={mainContent.purchaseLink} class="link-text w-fit!">Purchase</a>
            </div>
        </section>
        <!-- Contact section -->
        <section class="relative flex flex-col justify-center items-center gap-8 md:gap-12 xl:gap-18">
            <h2 class="title-text flex items-center justify-center w-[80dvw] md:w-[75dvw] xl:w-[55dvw]">
                {mainContent.contactText}
            </h2>
            <a href={mainContent.contactLink} class="link-text text-center">Contact Us</a>
        </section>
        <!-- Drawer Content -->
        <DrawerContent />
        <NewsletterSignup />
    </main>
</div>