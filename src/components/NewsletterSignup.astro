<div
        id="newsletter-overlay"
        class="fixed inset-0 z-40 bg-black/70 opacity-0 pointer-events-none transition-opacity duration-500"
></div>

<div
        id="newsletter-drawer"
        class="
        flex justify-center items-center
        fixed bottom-0 left-0 z-50
        w-full
        h-[30dvh] md:h-[40dvh] xl:h-[60dvh] 2xl:h-[40dvh]
        translate-y-full
        bg-cream text-teal
        transition-transform duration-500
    "
>
    <div class="drawer-top-bar fixed! header-footer-text">
        <p>Sign Up For Updates</p>

        <button
                type="button"
                data-newsletter-close
                class="header-footer-text"
        >
            Close
        </button>
    </div>

    <div class="w-full xl:w-2/3 px-6">

        <iframe
                name="substack-signup"
                class="hidden"
                title="Newsletter signup"
        ></iframe>

        <form
                id="newsletter-form"
                action="https://zoecoady.substack.com/api/v1/free"
                method="POST"
                target="substack-signup"
                novalidate
                class="flex flex-col gap-3"
        >
            <input
                    type="hidden"
                    name="sessionStarted"
                    value=""
            />

            <input
                    type="hidden"
                    name="landingReferrer"
                    value=""
            />

            <input
                    type="hidden"
                    name="landingUrl"
                    value="https://zoecoady.substack.com/subscribe"
            />

            <input
                    type="hidden"
                    name="landingSurface"
                    value="publisher"
            />

            <input
                    type="hidden"
                    name="landingPublicationId"
                    value="2112925"
            />

            <input
                    type="hidden"
                    name="referrer"
                    value=""
            />

            <input
                    type="hidden"
                    name="first_url"
                    value="https://zoecoady.substack.com/subscribe"
            />

            <input
                    type="hidden"
                    name="first_referrer"
                    value=""
            />

            <input
                    type="hidden"
                    name="current_url"
                    value="https://zoecoady.substack.com/subscribe"
            />

            <input
                    type="hidden"
                    name="current_referrer"
                    value=""
            />

            <input
                    type="hidden"
                    name="first_session_url"
                    value="https://zoecoady.substack.com/subscribe"
            />

            <input
                    type="hidden"
                    name="first_session_referrer"
                    value=""
            />

            <input
                    type="hidden"
                    name="referral_code"
                    value=""
            />

            <input
                    type="hidden"
                    name="source"
                    value="subscribe_page"
            />

            <input
                    type="hidden"
                    name="referring_pub_id"
                    value=""
            />

            <input
                    type="hidden"
                    name="additional_referring_pub_ids"
                    value=""
            />

            <div class="flex flex-col md:flex-row md:justify-between gap-6 md:gap-4 2xl:gap-6">

                <div class="relative w-full h-fit py-1">
                    <input
                            id="newsletter-email"
                            name="email"
                            type="email"
                            placeholder="Email Address"
                            aria-describedby="newsletter-error"
                            class="
                            signup-text
                            text-center md:text-start
                            placeholder-teal
                            border-b border-teal
                            w-full
                            bg-transparent
                            outline-none
                            transition-colors
                        "
                    />
                    <p
                            id="newsletter-error"
                            class="newsletter-error hidden absolute -bottom-4 md:-bottom-5 xl:-bottom-6"
                            aria-live="polite"
                    ></p>
                </div>

                <button
                        type="submit"
                        class="signup-text text-center text-teal underline underline-offset-6 decoration-1 leading-10 mt-1 md:mt-0"
                >
                    Submit
                </button>

            </div>

        </form>

        <p
                id="newsletter-success"
                class="newsletter-success signup-text hidden"
                aria-live="polite"
        ></p>

    </div>
</div>

<script>
    const drawer = document.querySelector("#newsletter-drawer");
    const overlay = document.querySelector("#newsletter-overlay");

    const form = document.querySelector("#newsletter-form");
    const emailInput = document.querySelector("#newsletter-email");
    const errorMessage = document.querySelector("#newsletter-error");
    const successMessage = document.querySelector("#newsletter-success");

    const substackFrame = document.getElementById(
        "substack-signup-frame"
    );

    const sessionStartedInput = form?.querySelector(
        'input[name="sessionStarted"]'
    );

    if (sessionStartedInput instanceof HTMLInputElement) {
        sessionStartedInput.value = String(Date.now());
    }

    let newsletterSubmitting = false;

    function openNewsletter() {
        drawer?.classList.remove("translate-y-full");
        drawer?.classList.add("translate-y-0");

        overlay?.classList.remove(
            "opacity-0",
            "pointer-events-none"
        );

        overlay?.classList.add("opacity-100");

        document.body.classList.add("overflow-hidden");
    }


    function closeNewsletter() {
        drawer?.classList.remove("translate-y-0");
        drawer?.classList.add("translate-y-full");

        overlay?.classList.remove("opacity-100");

        overlay?.classList.add(
            "opacity-0",
            "pointer-events-none"
        );

        document.body.classList.remove("overflow-hidden");

        clearError();
    }


    function showError(message) {
        if (!(emailInput instanceof HTMLInputElement)) return;

        emailInput.classList.add("newsletter-input-error");
        emailInput.setAttribute("aria-invalid", "true");

        if (errorMessage) {
            errorMessage.textContent = message;
            errorMessage.classList.remove("hidden");
        }
    }


    function clearError() {
        if (!(emailInput instanceof HTMLInputElement)) return;

        emailInput.classList.remove("newsletter-input-error");
        emailInput.removeAttribute("aria-invalid");

        if (errorMessage) {
            errorMessage.textContent = "";
            errorMessage.classList.add("hidden");
        }
    }

    function showSuccess(message) {
        if (!successMessage) return;

        successMessage.textContent = message;
        successMessage.classList.remove("hidden");
        hideForm();
    }

    function clearSuccess() {
        if (!successMessage) return;

        successMessage.textContent = "";
        successMessage.classList.add("hidden");
    }

    function showForm() {
        form?.classList.remove("hidden");
    }

    function hideForm() {
        form?.classList.add("hidden");
    }

    function clearForm() {
        if (form instanceof HTMLFormElement) {
            form.reset();
        }
    }

    form?.addEventListener("submit", (event) => {
        clearError();
        clearSuccess();

        if (!(emailInput instanceof HTMLInputElement)) return;

        const email = emailInput.value.trim();

        if (!email) {
            event.preventDefault();
            showError("Please enter your email address to sign up.");
            return;
        }

        if (!emailInput.validity.valid) {
            event.preventDefault();
            showError("Please enter a valid email address to sign up.");
            return;
        }

        emailInput.value = email;

        const submitButton = form.querySelector(
            'button[type="submit"]'
        );

        if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true;
        }

        console.log("Submitting to Substack:", email);

        setTimeout(() => {
            clearForm();
            hideForm();
            showSuccess("Thank you for subscribing!");

            if (submitButton instanceof HTMLButtonElement) {
                submitButton.disabled = false;
            }
        }, 500);

    });

    substackFrame?.addEventListener("load", () => {
        if (!newsletterSubmitting) return;

        newsletterSubmitting = false;

        console.log("Substack signup completed.");

        clearError();
        clearForm();
        hideForm();
        showSuccess("Thank you for subscribing!");

        const submitButton = form?.querySelector(
            'button[type="submit"]'
        );

        if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
        }
    });

    emailInput?.addEventListener("input", () => {
        clearError();
        clearSuccess();
    });

    document.addEventListener("click", (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        if (target.closest("[data-newsletter-open]")) {
            showForm();
            clearSuccess();
            openNewsletter();
        }

        if (target.closest("[data-newsletter-close]")) {
            closeNewsletter();
        }
    });


    overlay?.addEventListener("click", closeNewsletter);
</script>