---
import { sanityClient } from "../lib/sanity";
import Collapsible from "./Collapsible.astro";
import PodcastCard from "./PodcastCard.astro";
import {urlFor} from "../lib/sanityImage.ts";
import NewsletterSignup from "./NewsletterSignup.astro";

const drawerContent = await sanityClient.fetch(`
  *[_type == "drawerContent"][0] {
    aboutMainText,
    aboutMissionText,
    aboutServicesText,
    aboutCollapsibleContent[] {
      title,
      description
    },
    aboutFounderImage,
    aboutFounderText,
    aboutLink1 {
        text,
        url
    },
    aboutLink2 {
        text,
        url
    },
    aboutLink3 {
        text,
        url
    },
    
    aboutDetailFounderImage,
    aboutDetailFounderText,
    aboutPodcastText,
    aboutVisibilityAdvText,
    aboutDetailLink1 {
        text,
        url
    },
    aboutDetailLink2 {
        text,
        url
    },
    aboutDetailLink3 {
        text,
        url
    },

    servicesMainText,
    servicesClientsText,
    servicesSubText,
    servicesCollapsibleContent[] {
      title,
      description
    },
    sectorsSubText,
    servicesSectorCollapsibleContent[] {
      title,
      description
    },
    clientLogos[] {
        image,
        text,
        url
    },
    servicesLink1 {
        text,
        url
    },
    servicesLink2 {
        text,
        url
    },
    servicesLink3 {
        text,
        url
    },

    podcastMainText,
    podcastCards[] {
      date,
      length,
      description
    },
    podcastLink1 {
        text,
        url
    },
    podcastLink2 {
        text,
        url
    },
    podcastSubTitle,
    podcastSubText,

    toolkitMainText,
    toolkitSubtext1,
    toolkitSubtext2,
    toolkitSubtext3,
    toolkitImages[] {
        image,
        text
    },
    visibilityAdvLink1 {
        text,
        url
    },
    visibilityAdvLink2 {
        text,
        url
    },
    
    contactMainText,
    contactAddress {
      street,
      cityStateZip
    },
    contactEmail1,
    contactEmail2,
    aboutTitle,
    servicesTitle,
    podcastTitle,
    toolkitTitle,
    contactTitle,
  }
`);


const mainContent = await sanityClient.fetch(`
*[_type == "mainContent"][0] {
    spotifyLink,
    appleLink,
}
`);
---
<!-- Darken overlay  -->
<div
        id="drawer-overlay"
        class="fixed inset-0 z-40 bg-black/70 opacity-0 pointer-events-none transition-opacity duration-500"
></div>

<div
        id="drawer"
        class="
                fixed bottom-0 left-0
                z-40
                w-dvw h-[92dvh]
                translate-y-full overflow-y-auto
                xl:top-0 xl:right-auto xl:bottom-auto
                xl:h-dvh xl:w-6xl 2xl:w-7xl
                xl:-translate-x-full xl:translate-y-0
                transition-transform duration-500
                bg-cream text-teal
            "
>
    <!-- ABOUT -->
    <div data-content="about" class="hidden">
        <div class="drawer-top-bar header-footer-text">
            <p>{drawerContent.aboutTitle}</p>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section>
                <p>{drawerContent.aboutMainText}</p>
                <a href={drawerContent.aboutLink1?.url} data-drawer-link class="link-text mt-7">{drawerContent.aboutLink1?.text}</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Our Mission</h3>
                <p class="mt-7">{drawerContent.aboutMissionText}</p>
            </section>
            <section class="w-full border-teal">
                <h3 class="drawer-title-text">Services</h3>
                <p class="mt-7">{drawerContent.aboutServicesText}</p>
                <Collapsible items={drawerContent.aboutCollapsibleContent} />
                <a href={drawerContent.aboutLink2?.url} data-drawer-link class="link-text mt-7">{drawerContent.aboutLink2?.text}</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Our Founder<br/>Zoe Weisberg Coady</h3>
                <img
                        src={urlFor(drawerContent.aboutFounderImage).width(1200).url()}
                        alt="Portrait of Zoe Weisberg Coady"
                        class="w-full object-cover mt-7"
                />
                <p class="mt-7">{drawerContent.aboutFounderText}</p>
                <a href={drawerContent.aboutLink3?.url} data-drawer-link class="link-text mt-7 text-start">{drawerContent.aboutLink3?.text}</a>
            </section>
        </div>
    </div>
    <!-- ABOUT (DETAIL) -->
    <div data-content="about-detail" class="hidden bg-cream text-teal">
        <div class="drawer-top-bar header-footer-text">
            <button data-drawer="about" class="header-footer-text">Back to About</button>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section class="w-full">
                <h3 class="drawer-title-text">Our Founder<br/>Zoe Weisberg Coady</h3>
                <img
                        src={urlFor(drawerContent.aboutFounderImage).width(1200).url()}
                        alt="The Visibility Advantage"
                        class="w-full object-cover mt-7"
                />
                <p class="mt-7">{drawerContent.aboutFounderText}</p>
                <a href={drawerContent.aboutDetailLink1?.url} data-drawer-link class="link-text mt-7 text-start">{drawerContent.aboutDetailLink1?.text}</a>
            </section>
            <section class="w-full">
                <PodcastCard altLayout={true} />
                <p class="mt-7 body-text">{drawerContent.aboutPodcastText}</p>
                <div class="mt-7">
                    <a href={mainContent.spotifyLink} class="link-text">Listen on Spotify</a>
                    <a href={mainContent.appleLink} class="link-text mt-5">Listen on Apple Music</a>
                </div>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">the visibility advantage</h3>
                <p class="mt-7">{drawerContent.aboutVisibilityAdvText}</p>
                <div class="flex gap-10 mt-7">
                    <a href={drawerContent.aboutDetailLink2?.url} data-drawer-link class="link-text w-fit!">{drawerContent.aboutDetailLink2?.text}</a>
                    <a href={drawerContent.aboutDetailLink3?.url} data-drawer-link class="link-text w-fit!">{drawerContent.aboutDetailLink3?.text}</a>
                </div>
            </section>
        </div>
    </div>
    <!-- SERVICES -->
    <div data-content="services" class="hidden bg-cream text-teal">
        <div class="drawer-top-bar header-footer-text">
            <p>{drawerContent.servicesTitle}</p>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section class="w-full">
                <p>{drawerContent.servicesMainText}</p>
                <a href={drawerContent.servicesLink1?.url} data-drawer-link class="link-text mt-7">{drawerContent.servicesLink1?.text}</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Our Clients</h3>
                <p class="mt-7">{drawerContent.servicesClientsText}</p>
            </section>
            <section class="w-full border-teal">
                <h3 class="drawer-title-text">Services</h3>
                <p class="mt-7">{drawerContent.servicesSubText}</p>
                <Collapsible items={drawerContent.servicesCollapsibleContent} />
                <a href={drawerContent.servicesLink2?.url} data-drawer-link class="link-text mt-7">{drawerContent.servicesLink2?.text}</a>
            </section>
            <section class="w-full border-teal">
                <h3 class="drawer-title-text">Sectors</h3>
                <p class="mt-7">{drawerContent.sectorsSubText}</p>
                <Collapsible items={drawerContent.servicesSectorCollapsibleContent} />
                <a href={drawerContent.servicesLink3?.url} data-drawer-link class="link-text mt-7">{drawerContent.servicesLink3?.text}</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Select Clients</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 justify-items-center gap-x-6 gap-y-4 md:gap-y-10 md:gap-x-18 mt-7 md:mt-12">
                    {drawerContent.clientLogos?.map((client) => (
                            <a
                                    href={client.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                            >
                                <img
                                        src={urlFor(client.image).width(600).url()}
                                        alt={client.text || ""}
                                        class="w-full h-full object-contain"
                                />
                            </a>
                    ))}
                </div>
            </section>
        </div>
    </div>
    <!-- PODCAST -->
    <div data-content="podcast" class="hidden bg-cream text-teal">
        <div class="drawer-top-bar header-footer-text">
            <p>{drawerContent.podcastTitle}</p>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section>
                <p class="mt-7">{drawerContent.podcastMainText}</p>
                <div class="mt-7">
                    <a href={mainContent.spotifyLink} class="link-text">Listen on Spotify</a>
                    <a href={mainContent.appleLink} class="link-text mt-5">Listen on Apple Music</a>
                </div>
            </section>
            <section class="flex flex-col gap-8">
                {drawerContent.podcastCards.map((podcast) => (
                        <PodcastCard
                                date={podcast.date}
                                length={podcast.length}
                                description={podcast.description}
                                altLayout={true}
                        />
                ))}
                <a href={drawerContent.podcastLink1?.url} data-drawer-link class="link-text mt-7 text-start md:text-center">{drawerContent.podcastLink1?.text}</a>
            </section>
            <section>
                <h3 class="drawer-title-text">{drawerContent.podcastSubTitle}</h3>
                <p class="mt-7">{drawerContent.podcastSubText}</p>
                <a href={drawerContent.podcastLink2?.url} data-drawer-link class="link-text mt-7">{drawerContent.podcastLink2?.text}</a>
            </section>
        </div>
    </div>
    <!-- VISIBILITY ADV -->
    <div data-content="visibility-adv" class="hidden bg-cream text-teal">
        <div class="drawer-top-bar header-footer-text">
            <p>{drawerContent.toolkitTitle}</p>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section>
                <h3 class="drawer-title-text">The Visibility Advantage</h3>
                <p class="mt-7">{drawerContent.toolkitMainText}</p>
                <a href={drawerContent.i?.url} data-drawer-link class="link-text mt-7">{drawerContent.visibilityAdvLink1?.text}</a>
            </section>
            <section class="flex flex-col gap-8 md:gap-24">
                {drawerContent.toolkitImages?.map((toolkit) => (
                    <div class="relative">
                        <img
                                src={urlFor(toolkit.image).width(1200).url()}
                                alt={toolkit.text}
                                class="w-full object-cover gradient-image"
                        />
                        <p class="mt-4">{toolkit.text}</p>
                    </div>
                ))}
            </section>
            <section class="w-full">
                <a href={drawerContent.visibilityAdvLink2?.url} data-drawer-link class="link-text mt-7">{drawerContent.visibilityAdvLink2?.text}</a>
            </section>
        </div>
    </div>
    <!-- CONTACT -->
    <div data-content="contact" class="hidden bg-cream text-teal">
        <div class="drawer-top-bar header-footer-text">
            <p>{drawerContent.contactTitle}</p>
            <button data-drawer-close class="header-footer-text" type="button">Close</button>
        </div>
        <div class="drawer-body-container drawer-body-text">
            <section class="w-full">
                <p class="text-start">{drawerContent.contactMainText}</p>
            </section>
            <section class="w-full">
                <div>
                    <h3 class="drawer-title-text mb-5">Address</h3>
                    <p>{drawerContent.contactAddress.street}</p>
                    <p>{drawerContent.contactAddress.cityStateZip}</p>
                </div>
            </section>
            <section class="flex flex-col md:flex-row gap-10 md:gap-40 w-full">
                <div>
                    <h3 class="drawer-title-text">Inquiries</h3>
                    <a href={`mailto: ${drawerContent.contactEmail1}`} class="mt-5">{drawerContent.contactEmail1}</a>
                </div>
                <div>
                    <h3 class="drawer-title-text">Careers</h3>
                    <a href={`mailto: ${drawerContent.contactEmail2}`} class="mt-5">{drawerContent.contactEmail2}</a>
                </div>
            </section>
        </div>
    </div>
</div>