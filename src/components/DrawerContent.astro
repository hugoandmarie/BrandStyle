---
import {drawerContent} from "../data/drawer-content";
import Collapsible from "./Collapsible.astro";
import PodcastCard from "./PodcastCard.astro";
import {mainContent} from "../data/main-content";
---
<div
        id="drawer"
        class="
                fixed bottom-0 left-0
                z-10
                w-dvw h-[92dvh]
                translate-y-full overflow-y-auto
                md:top-0 md:right-auto md:bottom-auto
                md:h-dvh md:w-1/2
                md:-translate-x-full md:translate-y-0
                transition-transform duration-500
            "
>
    <div data-content="about" class="hidden bg-cream text-teal">
        <div class="flex justify-between w-full nav-text sticky top-0 p-4 bg-cream">
            <p>About</p>
            <button data-drawer-close class="nav-text" type="button">Close</button>
        </div>
        <div class="flex flex-col items-center gap-24 drawer-body-text mt-12 pb-28 px-6">
            <section>
                <p>{drawerContent.aboutMainText}</p>
                <a href="" class="link-text mt-7">Work With Us</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Our Mission</h3>
                <p class="mt-7">{drawerContent.aboutMissionText}</p>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Services</h3>
                <p class="mt-7">{drawerContent.aboutServicesText}</p>
            </section>
            <section class="w-full border-t border-teal">
                <Collapsible items={drawerContent.aboutCollapsibleContent} />
                <a href="" class="link-text mt-7">Work With Us</a>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">Our Founder<br/>Zoe Weisberg Coady</h3>
                <img src="/images/founder-image.png" alt="founder_portrait_b&w" class="w-full object-cover mt-7"/>
                <p class="mt-7">{drawerContent.aboutFounderText}</p>
                <button data-drawer="about-detail" class="link-text mt-7 text-start">Learn More</button>
            </section>
        </div>
    </div>

    <div data-content="about-detail" class="hidden bg-cream text-teal">
        <div class="flex justify-between w-full nav-text sticky top-0 p-4 bg-cream">
            <button data-drawer="about" class="nav-text">Back to About</button>
            <button data-drawer-close class="nav-text" type="button">Close</button>
        </div>
        <div class="flex flex-col items-center gap-24 drawer-body-text mt-12 pb-28 px-6">
            <section class="w-full">
                <h3 class="drawer-title-text">Our Founder<br/>Zoe Weisberg Coady</h3>
                <img src="/images/founder-image.png" alt="founder_portrait_b&w" class="w-full object-cover mt-7"/>
                <p class="mt-7">{drawerContent.aboutFounderText}</p>
                <a href="" class="link-text mt-7">Work With Us</a>
            </section>
            <section class="w-full">
                <PodcastCard />
                {drawerContent.aboutPodcastText.map((paragraph) => (
                        <p class="mt-7">{paragraph}</p>
                ))}
                <div class="mt-7">
                    <a href={mainContent.spotifyLink} class="link-text">Listen on Spotify</a>
                    <a href={mainContent.appleLink} class="link-text mt-5">Listen on Apple Music</a>
                </div>
            </section>
            <section class="w-full">
                <h3 class="drawer-title-text">the visibility advantage</h3>
                {drawerContent.aboutVisibilityAdvText.map((paragraph) => (
                        <p class="mt-7">{paragraph}</p>
                ))}
                <div class="flex gap-10 mt-7">
                    <a href="" class="link-text w-fit!">Learn More</a>
                    <a href="" class="link-text w-fit!">Purchase</a>
                </div>
            </section>
        </div>
    </div>
</div>