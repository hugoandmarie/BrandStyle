---
import { sanityClient } from "../lib/sanity";

const headerFooterContent = await sanityClient.fetch(`
    *[_type == "headerFooterContent"][0] {
        footerNavItems[] {
            label,
            type,
            path,
            url
        },

        socialLinks[] {
            label,
            url
        },

        addressText,
        copyrightText
    }
`);

const footerNavItems = headerFooterContent?.footerNavItems || [];
const socialLinks = headerFooterContent?.socialLinks || [];

const currentYear = new Date().getFullYear();
---

<footer class="body-text text-cream flex flex-col gap-20 items-center mt-32 md:mt-52 px-[6dvw] pb-24">

    <nav class="flex md:flex-col justify-between md:justify-center md:gap-8 [&_button]:text-start">

        <!-- Desktop -->
        <div class="hidden xl:flex justify-center gap-12">
            {footerNavItems.map((item) => (
                item.type === "newsletter" ? (
                        <button
                                type="button"
                                data-newsletter-open
                                class="body-text"
                        >
                            {item.label}
                        </button>
                ) : item.type === "external" ? (
                        <a
                                href={item.url || "#"}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="body-text"
                        >
                            {item.label}
                        </a>
                ) : (
                        <a
                                href={item.path}
                                data-drawer-link
                                class="body-text"
                        >
                            {item.label}
                        </a>
                )
            ))}

            {socialLinks.map((item) => (
                    <a
                            href={item.url || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="body-text"
                    >
                        {item.label}
                    </a>
            ))}
        </div>


        <!-- Tablet -->
        <div class="hidden md:flex xl:hidden justify-center gap-12">
            {footerNavItems.map((item) => (
                item.type === "newsletter" ? (
                        <button
                                type="button"
                                data-newsletter-open
                                class="body-text"
                        >
                            {item.label}
                        </button>
                ) : item.type === "external" ? (
                        <a
                                href={item.url || "#"}
                                class="body-text"
                        >
                            {item.label}
                        </a>
                ) : (
                        <a
                                href={item.path}
                                data-drawer-link
                                class="body-text"
                        >
                            {item.label}
                        </a>
                )
            ))}
        </div>

        <div class="hidden md:flex xl:hidden justify-center gap-12">
            {socialLinks.map((item) => (
                    <a
                            href={item.url || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="body-text"
                    >
                        {item.label}
                    </a>
            ))}
        </div>


        <!-- Mobile -->
        <div class="md:hidden grid grid-cols-2 gap-x-12 gap-y-8">
            {footerNavItems.map((item) => (
                item.type === "newsletter" ? (
                        <button
                                type="button"
                                data-newsletter-open
                                class="body-text"
                        >
                            {item.label}
                        </button>
                ) : item.type === "external" ? (
                        <a
                                href={item.url || "#"}
                                class="body-text"
                        >
                            {item.label}
                        </a>
                ) : (
                        <a
                                href={item.path}
                                data-drawer-link
                                class="body-text"
                        >
                            {item.label}
                        </a>
                )
            ))}
        </div>

    </nav>


    <!-- Mobile social links -->
    <ul class="flex md:hidden body-text w-full justify-evenly">
        {socialLinks.map((item) => (
                <li>
                    <a
                            href={item.url || "#"}
                            target="_blank"
                            rel="noopener noreferrer"
                    >
                        {item.label}
                    </a>
                </li>
        ))}
    </ul>


    <!-- Footer details -->
    <div class="flex flex-col items-center w-full text-center text-xs px-0 opacity-50">

        {headerFooterContent?.addressText && (
                <p class="w-full">
                    {headerFooterContent.addressText}
                </p>
        )}

        <p class="mt-8 md:mt-2 w-full md:w-[70dvw]">
            {
                headerFooterContent?.copyrightText
                    ? headerFooterContent.copyrightText
                    : `Copyright © ${currentYear} Brandstyle Communications, LLC. All Rights Reserved.`
            }
        </p>

    </div>

</footer>