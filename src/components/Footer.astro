---
import {mainContent} from "../data/main-content";

const navItems_1 = [
    {
        label: "About",
        link: "#",
    },
    {
        label: "Services",
        link: "#",
    },
    {
        label: "Podcast",
        link: "#",
    },
];

const navItems_2 = [
    {
        label: "Toolkit",
        link: "#",
    },
    {
        label: "Contact",
        link: "#",
    },
    {
        label: "Sign Up For Updates",
        link: "#",
    },
]

const socialLinks = [
    {
        label: "IG",
        link: "#",
    },
    {
        label: "FB",
        link: "#",
    },
    {
        label: "LI",
        link: "#",
    },
]
---
<footer class="body-text text-cream flex flex-col gap-20 mt-32 md:mt-52 px-[6dvw] pb-24">
    <nav class="flex md:flex-col justify-between md:justify-center md:gap-8">
        <!-- Tablet layout -->
        <div class="hidden md:flex justify-center gap-12">
            {navItems_1.map((item) => (
                <a href={item.link}>
                    {item.label}
                </a>
            ))}
            {navItems_2.map((item, index) => (
                index !== 2 && (
                    <a href={item.link}>
                        {item.label}
                    </a>
                )
            ))}
        </div>
        <div class="hidden md:flex justify-center gap-12">
            {<a href={navItems_2[2].link}>
                {navItems_2[2].label}
            </a>}
            {socialLinks.map((item) => (
                <a href={item.link}>
                    {item.label}
                </a>
            ))}
        </div>
        <!-- Mobile layout -->
        <div class="md:hidden flex flex-col gap-8">
            {navItems_1.map((item) => (
                <a href={item.link}>
                    {item.label}
                </a>
            ))}
        </div>
        <div class="md:hidden flex flex-col gap-8">
            {navItems_2.map((item) => (
                    <a href={item.link}>
                        {item.label}
                    </a>
            ))}
        </div>
    </nav>
    <ul class="flex justify-between md:hidden">
        <li>
            <a href="#">IG</a>
        </li>
        <li>
            <a href="#">FB</a>
        </li>
        <li>
            <a href="#">LI</a>
        </li>
    </ul>
    <div class="flex flex-col items-center w-full text-center text-xs px-0 opacity-50">
        <p class="w-full">{mainContent.addressText}</p>
        <p class="mt-8 md:mt-2 w-full md:w-[70dvw]">Copyright &copy; <span>{new Date().getFullYear()}</span> Brandstyle Communications, LLC. All Rights Reserved. <a href="">Privacy Policy</a></p>
    </div>
</footer>