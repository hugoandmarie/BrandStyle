---
import { sanityClient } from "../lib/sanity";

const mainContent = await sanityClient.fetch(`
*[_type == "mainContent"][0] {
    instagramLink,
    facebookLink,
    linkedinLink,
    addressText,
    }
`);

const navItems_1 = [
    {
        label: "About",
        link: "about",
    },
    {
        label: "Services",
        link: "services",
    },
    {
        label: "Podcast",
        link: "podcast",
    },
];

const navItems_2 = [
    {
        label: "Toolkit",
        link: "toolkit",
    },
    {
        label: "Contact",
        link: "contact",
    },
    {
        label: "Sign Up For Updates",
        link: "signup",
    },
]

const socialLinks = [
    {
        label: "IG",
        link: mainContent.instagramLink || "#",
    },
    {
        label: "FB",
        link: mainContent.facebookLink || "#",
    },
    {
        label: "LI",
        link: mainContent.linkedinLink || "#",
    },
];
---
<footer class="body-text text-cream flex flex-col gap-20 mt-32 md:mt-52 px-[6dvw] pb-24">
    <nav class="flex md:flex-col justify-between md:justify-center md:gap-8 [&_button]:text-start">
        <!-- Desktop layout -->
        <div class="hidden xl:flex justify-center gap-12">
            {navItems_1.map((item) => (
                <button data-drawer={item.link} class="body-text">{item.label}</button>
            ))}
            {navItems_2.map((item, index) => (
                <button data-drawer={item.link} class="body-text">{item.label}</button>
            ))}
            {socialLinks.map((item) => (
                <a href={item.link} target="_blank" class="body-text">
                    {item.label}
                </a>
            ))}
        </div>
        <!-- Tablet layout -->
        <div class="hidden xl:hidden md:flex justify-center gap-12">
            {navItems_1.map((item) => (
                <button data-drawer={item.link} class="body-text">{item.label}</button>
            ))}
            {navItems_2.map((item, index) => (
                index !== 2 && (
                    <button data-drawer={item.link} class="body-text">{item.label}</button>
                )
            ))}
        </div>
        <div class="hidden xl:hidden md:flex justify-center gap-12">
            <button data-drawer={navItems_2[2].link} class="body-text">
                {navItems_2[2].label}
            </button>
            {socialLinks.map((item) => (
                <a href={item.link} target="_blank" class="body-text">
                    {item.label}
                </a>
            ))}
        </div>
        <!-- Mobile layout -->
        <div class="md:hidden flex flex-col gap-8">
            {navItems_1.map((item) => (
                <button data-drawer={item.link} class="body-text">{item.label}</button>
            ))}
        </div>
        <div class="md:hidden flex flex-col gap-8">
            {navItems_2.map((item) => (
                <button data-drawer={item.link} class="body-text">{item.label}</button>
            ))}
        </div>
    </nav>
    <!-- Mobile only -->
    <ul class="flex md:hidden justify-between body-text">
        <li>
            <a href={mainContent.instagramLink} target="_blank">IG</a>
        </li>
        <li>
            <a href={mainContent.facebookLink} target="_blank">FB</a>
        </li>
        <li>
            <a href={mainContent.linkedinLink} target="_blank">LI</a>
        </li>
    </ul>
    <div class="flex flex-col items-center w-full text-center text-xs px-0 opacity-50">
        <p class="w-full">{mainContent.addressText}</p>
        <!-- TODO: add privacy policy -->
        <p class="mt-8 md:mt-2 w-full md:w-[70dvw]">Copyright &copy; <span>{new Date().getFullYear()}</span> Brandstyle Communications, LLC. All Rights Reserved. <a href="">Privacy Policy</a></p>
    </div>
</footer>