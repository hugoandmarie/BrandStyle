---
import { sanityClient } from "../lib/sanity";

const headerFooterContent = await sanityClient.fetch(`
    *[_type == "headerFooterContent"][0] {
        headerNavItems[] {
            label,
            path,
            showOnMobile,
            showOnDesktop
        }
    }
`);
---

<header class="w-dvw h-fit fixed bottom-0 xl:top-0 xl:bottom-auto z-50 xl:z-30 bg-teal border-t border-white/30 xl:border-none p-5 md:px-14">
    <nav class="text-cream text-xs overflow-x-auto xl:overflow-visible">
        <ul class="flex w-full xl:w-auto justify-between xl:justify-center gap-8 xl:gap-14 items-center">
            {headerFooterContent?.headerNavItems?.map((item) => (
                    <li
                            class:list={[
                                "shrink-0 whitespace-nowrap",
                                !item.showOnMobile && item.showOnDesktop && "hidden xl:block",
                                item.showOnMobile && !item.showOnDesktop && "block xl:hidden",
                                !item.showOnMobile && !item.showOnDesktop && "hidden",
                            ]}
                    >
                        <a
                                href={item.path}
                                data-drawer-link
                                data-nav-path={item.path}
                                class="header-footer-text whitespace-nowrap transition-opacity duration-200"
                        >
                            {item.label}
                        </a>
                    </li>
            ))}
        </ul>
    </nav>
</header>

<script>
    // add nested drawer routes in array to maintain active link status
    const navRouteGroups = {
        "/about": ["/about", "/about-detail"],
        "/services": ["/services"],
        "/podcast": ["/podcast"],
        "/visibility-adv": ["/visibility-adv"],
        "/contact": ["/contact"],
    };

    function updateActiveNav() {
        const currentPath = window.location.pathname;

        document
            .querySelectorAll("[data-nav-path]")
            .forEach((link) => {
                if (!(link instanceof HTMLAnchorElement)) return;

                const linkPath = link.dataset.navPath;
                const isIndex = currentPath === "/";

                const isActive =
                    navRouteGroups[linkPath]?.includes(currentPath) ?? false;

                link.classList.toggle(
                    "opacity-100",
                    isIndex || isActive
                );

                link.classList.toggle(
                    "opacity-75",
                    !isIndex && !isActive
                );
            });
    }

    // Initial state
    updateActiveNav();

    // Drawer navigation
    window.addEventListener(
        "drawer-route-change",
        updateActiveNav
    );

    // Browser back / forward
    window.addEventListener(
        "popstate",
        updateActiveNav
    );
</script>