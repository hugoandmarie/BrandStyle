---
import { sanityClient } from "../lib/sanity";

const headerFooterContent = await sanityClient.fetch(`
    *[_type == "headerFooterContent"][0] {
        headerNavItems[] {
            label,
            path,
            showOnMobile,
            showOnDesktop
        }
    }
`);
---

<header class="w-dvw h-fit fixed bottom-0 xl:top-0 xl:bottom-auto z-50 xl:z-30 bg-teal border-t border-white/30 xl:border-none p-5 md:px-14">
    <nav class="text-cream text-xs overflow-x-auto xl:overflow-visible">
        <ul class="flex w-full xl:w-auto justify-between xl:justify-center gap-6 xl:gap-14 items-center">
            {headerFooterContent?.headerNavItems?.map((item) => (
                    <li
                            class:list={[
                                "shrink-0 whitespace-nowrap",
                                !item.showOnMobile && item.showOnDesktop && "hidden xl:block",
                                item.showOnMobile && !item.showOnDesktop && "block xl:hidden",
                                !item.showOnMobile && !item.showOnDesktop && "hidden",
                            ]}
                    >
                        <a
                                href={item.path}
                                data-drawer-link
                                class="nav-text whitespace-nowrap"
                        >
                            {item.label}
                        </a>
                    </li>
            ))}
        </ul>
    </nav>
</header>