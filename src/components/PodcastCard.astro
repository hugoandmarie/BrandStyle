---
import { sanityClient } from "../lib/sanity";
import { urlFor } from "../lib/sanityImage";

const mainContent = await sanityClient.fetch(`
*[_type == "mainContent"][0] {
    podcastImage,
    podcastTitle,
    podcastSubtitle,
    podcastRating,
    podcastTag1,
    podcastTag2,
}
`);

const {
    date = null,
    length = null,
    description = null,
    altLayout = false,
} = Astro.props;

const hasEpisodeData = date || length || description;
---

<div
        class={`podcast-card relative isolate w-full ${
            altLayout ? "" : "xl:w-10/12 2xl:w-5/12"
        }`}
>
    <div class="podcast-card-bg absolute inset-0 z-0 rounded-[2.5rem]"></div>

    <div
            class={`podcast-content relative z-10 w-full flex
            p-6 md:p-9 2xl:p-9
            rounded-[2.5rem]
            text-cream body-text text-xs md:text-sm!
            ${
                altLayout
                    ? `
                        flex-col md:flex-row
                        md:max-h-96
                        justify-center md:justify-start
                        md:items-center
                        text-center md:text-start
                        gap-6 md:gap-10
                        pb-10
                    `
                    : `
                        flex-col
                        justify-center
                        text-center
                        gap-6
                        pb-8 md:pb-10 2xl:pb-14
                    `
            }`}
    >

        <!-- Podcast Image -->
        <div
                class:list={[
                    altLayout
                        ? "md:self-stretch md:shrink-0 md:max-w-[30%] flex items-center justify-start"
                        : "w-full",
                ]}
        >
            <img
                    src={urlFor(mainContent.podcastImage).width(1200).url()}
                    alt="podcast_thumbnail_image"
                    class:list={[
                        "block rounded-4xl",
                        altLayout
                            ? "max-h-full max-w-full w-auto h-auto"
                            : "w-full h-auto",
                    ]}
            />
        </div>


        <!-- Podcast Content -->
        <div
                class:list={[
                    "flex flex-col gap-6",
                    altLayout
                        ? "flex-1 justify-between md:pl-0"
                        : "",
                    altLayout && !hasEpisodeData
                        ? "h-9/12 max-h-10/12 md:gap-10"
                        : "",
                ]}
        >
            {hasEpisodeData ? (
                    <>
                        <div
                                class:list={[
                                    "flex gap-5",
                                    altLayout
                                        ? "justify-center md:justify-start"
                                        : "justify-center",
                                ]}
                        >
                            <p>{date}</p>
                            <p>{length}</p>
                        </div>

                        <div
                                class:list={[
                                    "w-full flex",
                                    altLayout
                                        ? "flex-col gap-4 md:gap-6 xl:gap-8"
                                        : "flex-row items-center",
                                ]}
                        >
                            <p>{description}</p>

                            <p
                                    class:list={[
                                        "font-normal",
                                        altLayout ? "mt-0" : "mt-2",
                                    ]}
                            >
                                The Not Perfect Networking Podcast
                            </p>
                        </div>
                    </>
            ) : (
                    <>
                        <div class="font-normal">
                            <h2>{mainContent.podcastTitle}</h2>

                            <p class="mt-2">
                                {mainContent.podcastSubtitle}
                            </p>
                        </div>

                        <div
                                class:list={[
                                    "w-full flex items-center md:gap-5 podcast-rating-text flex-wrap",
                                    altLayout
                                        ? "flex-row"
                                        : "flex-col md:flex-row md:justify-center",
                                ]}
                        >
                            <div class="flex gap-5 items-center">
                                <p class="flex items-center gap-2 whitespace-nowrap! text-nowrap!">
                                    <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="12"
                                            height="11"
                                            viewBox="0 0 12 11"
                                            fill="none"
                                    >
                                        <path
                                                d="M5.27829 0.255209C5.46955 -0.0841132 5.95819 -0.084113 6.14944 0.255209L7.66463 2.94342C7.73598 3.07001 7.85887 3.15929 8.00131 3.18803L11.0262 3.79836C11.408 3.8754 11.559 4.34012 11.2954 4.62687L9.20695 6.8986C9.10861 7.00558 9.06167 7.15005 9.07835 7.2944L9.43263 10.3598C9.47735 10.7467 9.08203 11.034 8.72785 10.8719L5.92195 9.58766C5.78982 9.52718 5.63792 9.52718 5.50579 9.58766L2.69988 10.8719C2.34571 11.034 1.95039 10.7467 1.99511 10.3598L2.34939 7.2944C2.36607 7.15005 2.31913 7.00558 2.22078 6.8986L0.132364 4.62687C-0.131249 4.34012 0.0197484 3.8754 0.401564 3.79836L3.42642 3.18803C3.56886 3.15929 3.69175 3.07001 3.7631 2.94342L5.27829 0.255209Z"
                                                fill="#EDEDED"
                                        />
                                    </svg>

                                    {mainContent.podcastRating}
                                </p>

                                <p class="whitespace-nowrap! text-nowrap!">
                                    {mainContent.podcastTag1}
                                </p>
                            </div>

                            <p class={`whitespace-nowrap! text-nowrap! ${altLayout ? "mt-0" : "mt-2 md:mt-0"}`}>
                                {mainContent.podcastTag2}
                            </p>
                        </div>
                    </>
            )}

            <div
                    class:list={[
                        "flex gap-6 xl:gap-8 w-full",
                        altLayout
                            ? "justify-center md:justify-start md:max-h-8"
                            : "justify-center",
                    ]}
            >
                <img
                        src="/images/Spotify.svg"
                        alt="spotify_logo"
                />

                <img
                        src="/images/Apple.svg"
                        alt="apple_podcast_logo"
                />
            </div>
        </div>
    </div>
</div>