---
import { sanityClient } from "../lib/sanity";
import { urlFor } from "../lib/sanityImage";
const mainContent = await sanityClient.fetch(`
*[_type == "mainContent"][0] {
    podcastImage,
    }
`);

const {
    date = null,
    length = null,
    description = null,
    altLayout = false,
} = Astro.props;

const hasEpisodeData = date || length || description;
---

<div class={`podcast-card relative isolate w-full ${altLayout ? "" : "xl:w-10/12 2xl:w-5/12"}`}>
    <div class="podcast-card-bg absolute inset-0 z-0 rounded-[2.5rem]"></div>
    <!--<div class="podcast-card-bg-2 absolute inset-0 z-0"></div>-->
    <div class={`podcast-content relative z-10 w-full flex
        p-6 md:p-9 2xl:p-9 rounded-[2.5rem]
        text-cream body-text text-xs md:text-sm!
        ${altLayout ?
            "md:h-64 lg:h-72 flex-col md:flex-row justify-center md:justify-start md:items-center text-center md:text-start gap-6 md:gap-0 pb-10"
        :
            "flex-col justify-center text-center gap-6 pb-8 md:pb-10 2xl:pb-14"}`}>
        <img
                src={urlFor(mainContent.podcastImage).width(1200).url()}
                alt="podcast_thumbnail_image"
                class={`w-fit h-full rounded-4xl object-contain ${altLayout ? "" : ""}`}
        />
        <div class={`flex flex-col gap-6 h-full ${altLayout ? "justify-between md:w-8/12 xl:w-7/12 md:pl-10" : ""}`}>
            {hasEpisodeData ? (
                <>
                    <div class={`flex gap-5 ${altLayout ? "justify-center md:justify-start" : "justify-center"}`}>
                        <p>{date}</p>
                        <p class="">{length}</p>
                    </div>

                    <div class={`w-full flex ${altLayout ? "flex-col gap-4 md:gap-6 xl:gap-8" : "flex-row items-center"}`}>
                        <p>{description}</p>
                        <p class={`${altLayout ? "mt-0" : "mt-2"} font-normal`}>The Not Perfect Networking Podcast</p>
                    </div>
                </>
            ) : (
                <>
                    <div class="font-normal">
                        <h2>The Not Perfect Networking Podcast</h2>
                        <p class="mt-2">Zoe Weisberg Coady</p>
                    </div>

                    <div class={`w-full flex items-center md:justify-center md:gap-5 ${altLayout ? "flex-row" : "flex-col md:flex-row"}`}>
                        <div class="flex gap-5">
                            <p>5.0 (8)</p>
                            <p>Self-improvement</p>
                        </div>
                        <p class={`${altLayout ? "mt-0" : "mt-2 md:mt-0"}`}>Updated Weekly</p>
                    </div>
                </>
            )}
            <div class={`flex gap-6 xl:gap-8 w-full ${altLayout ? "justify-center md:justify-start  md:max-h-8" : "justify-center"}`}>
                <img src="/images/Spotify.svg" alt="spotify_logo">
                <img src="/images/Apple.svg" alt="apple_podcast_logo">
            </div>
        </div>
    </div>
</div>