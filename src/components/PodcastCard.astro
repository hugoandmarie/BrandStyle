---
const {
    date = null,
    length = null,
    description = null
} = Astro.props;

const hasEpisodeData = date || length || description;
---

<div id="podcast-card">
    <div id="podcast-card-bg" class="w-full h-full"></div>
    <div id="podcast-card-bg-2" class="w-full h-full"></div>
    <div class="podcast-content text-cream w-full min-h-[50dvh] p-6 flex items-center justify-center gap-6 body-text text-xs text-center">
        <img
                src="/images/podcast-image.png"
                alt="podcast_thumbnail_image"
                class="w-full h-full rounded-4xl"
        />
        {hasEpisodeData ? (
                <>
                    <div class="flex justify-center">
                        <p>{date}</p>
                        <p class="">{length}</p>
                    </div>

                    <div class="w-full flex flex-col items-center">
                        <p>{description}</p>
                    </div>
                </>
        ) : (
                <>
                    <div>
                        <h2>The Not Perfect Networking Podcast</h2>
                        <p class="mt-2">Zoe Weisberg Coady</p>
                    </div>

                    <div class="w-full flex flex-col items-center">
                        <div class="flex gap-5">
                            <p>5.0 (8)</p>
                            <p>Self-improvement</p>
                        </div>
                        <p class="mt-2">Updated Weekly</p>
                    </div>
                </>
        )}
        <div class="flex justify-center gap-8 w-full">
            <img src="/images/Spotify.svg" alt="spotify_logo">
            <img src="/images/Apple.svg" alt="apple_podcast_logo">
        </div>
    </div>
</div>