---
import { urlFor } from "../lib/sanityImage";

const {
    segments = [],
    className = ""
} = Astro.props;
---

<div class={`title-text ${className}`}>
    {segments.map((segment) => {
        if (segment._type === "inlineImage") {
            return (
                    <img
                            src={urlFor(segment).width(500).url()}
                            alt=""
                            class="
                                inline-block
                                w-[0.9em]
                                h-[1.05em]
                                object-cover
                                ml-[0.3em]
                                mr-[0.35em]
                                relative
                                top-[-0.1em]
                            "
                    />
            );
        }

        if (segment._type === "textSegment") {
            return <span>{segment.text}</span>;
        }

        return null;
    })}
</div>